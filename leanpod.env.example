# Namespace and kubeconfig
NRP_NAMESPACE=prove2me
NRP_CONTEXT=nautilus
NRP_KUBECONFIG="$HOME/.kube/nrp-nautilus.config"

# Default interactive workspace size: 8 CPU / 32 GiB ceiling.
LEANPOD_CPU_REQUEST=7
LEANPOD_CPU_LIMIT=8
LEANPOD_MEMORY_REQUEST=28Gi
LEANPOD_MEMORY_LIMIT=32Gi

# Defaults to 50Gi storage.
LEANPOD_STORAGE_SIZE=50Gi
LEANPOD_STORAGE_CLASS=rook-ceph-block
LEANPOD_REGION=us-west

# Pinned public Lean/Elan base image.
LEANPOD_IMAGE=ghcr.io/leanprover-community/mathlib4/lean@sha256:ad7d671404b347b74e6ec2d5e4088b6afb5d124c5c47f075e323a5294707ea9b

# Current Prove2ME env
PROVE2ME_TOOLCHAIN=leanprover/lean4:v4.33.1
PROVE2ME_MATHLIB_REV=0df444a360eaa60ab8c11dca51a86af692955474
PROVE2ME_REPO_URL=https://github.com/prove2me/prove2me_workspace.git
PROVE2ME_REPO_REF=main
